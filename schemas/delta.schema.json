                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "event_id",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target_id": {
                  "type": "string",
                  "minLength": 1
