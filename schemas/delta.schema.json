          "resolution": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          }
        },
        "required": [
          "op",
          "target_id",
          "value",
          "patch",
          "evidence",
          "scope",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "authority_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "enum": [
              "GRANT",
              "REVOKE",
              "NARROW",
              "EXPIRE"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
