                  "type": "string"
                }
              },
              "required": [
                "event_id",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "op",
          "target_id",
          "value",
          "evidence"
        ],
        "additionalProperties": false
