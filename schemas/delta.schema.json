  "required": [
    "schema_version",
    "delta_id",
    "conversation_id",
    "branch_id",
    "human_event_id",
    "base_state_version",
    "base_watermark",
    "operations",
    "authority_operations",
    "unresolved",
    "interpretation_method"
  ],
  "additionalProperties": false
