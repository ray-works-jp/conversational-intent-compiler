              },
              "required": [
                "target_id",
                "version",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "resolved_target": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolved_version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          },
          "behavior_changes": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "expression",
          "evidence",
          "candidates",
          "resolved_target",
          "resolved_version",
          "status",
          "behavior_changes",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "interpretation_method": {
      "enum": [
        "hand_authored_fixture",
        "reviewed_external_candidate"
      ]
    }
