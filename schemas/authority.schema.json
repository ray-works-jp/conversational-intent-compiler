{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cic:cic-prototype-0.1:authority",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "integer",
      "minimum": 0
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "equals": {}
        },
        "required": [
          "name",
          "equals"
        ],
        "additionalProperties": false
      }
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "conversation",
            "task",
            "turn"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "targets",
        "turn_id",
        "task_id",
        "valid_from",
        "valid_until"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "lifecycle": {
      "enum": [
        "active",
        "revoked",
        "expired"
      ]
    }
  },
  "required": [
    "id",
    "principal",
    "actor",
    "action",
    "target_id",
    "target_version",
    "conditions",
    "valid_from",
    "valid_until",
    "scope",
    "evidence",
    "lifecycle"
  ],
  "additionalProperties": false
}
